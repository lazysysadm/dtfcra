# dtfcra — variables d'environnement (validées par src/env.ts au démarrage).
# Copier vers .env et renseigner. Ne jamais committer .env.

# Connexion PostgreSQL (nom d'hôte = conteneur sur le réseau dtfcra-net).
DATABASE_URL=postgresql://dtfcra:CHANGE_ME@dtfcra-db:5432/dtfcra

# Mot de passe du conteneur PostgreSQL (compose.dev.yaml / scripts/dev-env.sh).
POSTGRES_PASSWORD=CHANGE_ME

# Secret Better Auth (>= 32 caractères).
# Générer : head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
BETTER_AUTH_SECRET=CHANGE_ME_64_HEX_CHARS

# URL publique de l'app (origine de confiance, cookies, liens).
APP_URL=http://127.0.0.1:3000

# NODE_ENV : NE PAS le définir ici — Next.js le gère (development en dev,
# production au build/start). Le forcer casse le prerender du build.

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Dossier des fichiers utilisateur (logos, gabarits xlsx), hors du public.
# En conteneur : monter un volume sur ce chemin (ex. /app/uploads).
UPLOAD_DIR=uploads

# IP/CIDR du reverse proxy (prod) pour récupérer la vraie IP client
# (piste d'audit, rate limiting). Vide en dev.
# OBLIGATOIRE en production (sinon refus de démarrer), sauf ALLOW_NO_TRUSTED_PROXY=true.
TRUSTED_PROXY=
# ALLOW_NO_TRUSTED_PROXY=false
# ALLOW_INSECURE_APP_URL=false