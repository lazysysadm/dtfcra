{
  "name": "dtfcra",
  "version": "0.1.0",
  "private": true,
  "description": "Application web auto-hébergée de CRA / timesheets pour freelances IT en régie.",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "better-auth generate --config src/server/auth/index.ts --output src/server/db/auth-schema.ts --yes",
    "auth:reset-password": "node --env-file-if-exists=.env --import tsx scripts/reset-password.ts",
    "auth:create-user": "node --env-file-if-exists=.env --import tsx scripts/create-user.ts",
    "licenses:notices": "node --import tsx scripts/generate-third-party-notices.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@date-fns/tz": "1.5.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@react-pdf/renderer": "4.9.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.11.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
